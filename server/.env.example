# Use an independent Venue database and credentials. Use independently generated secrets.
NODE_ENV=development
PORT=5000
VENUE_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
VENUE_DB_NAME=prakash_venue_development
# Generate each secret separately; minimum 32 characters.
VENUE_JWT_SECRET=
VENUE_CORS_ALLOWED_ORIGINS=http://localhost:5173
VENUE_COOKIE_SAME_SITE=lax
VENUE_TRUST_PROXY_HOPS=0
# Mandatory in every environment. There is no unpaid dashboard bypass.
VENUE_SUBSCRIPTION_MODE=required
VENUE_ENQUIRY_EXPIRY_HOURS=72
# Bare base hostname, without scheme. Empty uses /v/:slug locally.
PUBLIC_VENUE_DOMAIN=
VENUE_SERVE_CLIENT=false
VENUE_RESEND_API_KEY=
VENUE_EMAIL_FROM=
VENUE_GOOGLE_CLIENT_ID=
VENUE_CLOUDINARY_CLOUD_NAME=
VENUE_CLOUDINARY_API_KEY=
VENUE_CLOUDINARY_API_SECRET=
# Platform hall-subscription merchant only. Use independent test keys locally.
VENUE_SUBSCRIPTION_RAZORPAY_KEY_ID=
VENUE_SUBSCRIPTION_RAZORPAY_KEY_SECRET=
VENUE_SUBSCRIPTION_RAZORPAY_WEBHOOK_SECRET=

# Per-hall prices in INR rupees, up to 2 decimals. Blank means unavailable.
# 3 months = 90 days; 1 year = 365 days. Restart after editing.
VENUE_PLAN_3_MONTHS_PRICE=
VENUE_PLAN_1_YEAR_PRICE=
