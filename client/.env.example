# Same-origin /api is used by default. Vite proxies it to localhost:5000 during development.
VITE_VENUE_API_URL=/api
VITE_VENUE_GOOGLE_CLIENT_ID=
# Must match PUBLIC_VENUE_DOMAIN. Empty uses /v/:slug on the current origin.
VITE_PUBLIC_VENUE_DOMAIN=
# Platform landing page URL used by the footer of public venue websites.
VITE_VENUE_PLATFORM_URL=
