{
  "id": "/owner-app",
  "name": "Prakash SaaS Venue",
  "short_name": "Prakash Venue",
  "description": "Manage your venues, halls, bookings, availability, and subscriptions in one place.",
  "lang": "en",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "theme_color": "#244638",
  "background_color": "#faf9f6",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
